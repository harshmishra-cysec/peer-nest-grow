# Copy this file to application-local.properties (same folder) and fill in your values.
# application-local.properties is gitignored so secrets stay on your machine.
#
# You can also set DB_URL, DB_USER, DB_PASSWORD and JWT_SECRET as Windows
# environment variables instead of using this file.

DB_URL=jdbc:mysql://localhost:3306/skillnest
DB_USER=root
DB_PASSWORD=your_mysql_password
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
